{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", "index.ts", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["frontend", "backend", "node_modules"]
}
